{
  "manifest_version": 3,
  "name": "Printer Aid 2.6",
  "version": "1.0",
  "description": "Converts images and documents into a better format for printing",
  "icons": {
    "48": "icon.png"
  },
  "permissions": ["storage", "activeTab", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "annoying.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
